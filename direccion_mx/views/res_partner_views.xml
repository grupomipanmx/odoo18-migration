<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_address_gmp" model="ir.ui.view">
        <field name="name">res.partner.form.address.gmp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='zip']" position="after">
                <field name="ciudad_id" options="{'no_create': True}"/>
                <field name="municipio_id" domain="[('state_id', '=', state_id)]" options="{'no_create': True}"/>
                <field name="colonia_id" domain="[('municipio_id', '=', municipio_id)]" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
